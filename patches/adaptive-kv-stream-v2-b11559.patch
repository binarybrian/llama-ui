+struct encoder {
+    ggml_backend_t backend;
+    bool cuda;
+    size_t rows, row_bytes;
+    ggml_context_ptr context;
+    ggml_backend_buffer_ptr buffer;
+    ggml_tensor * source = nullptr, * output = nullptr;
