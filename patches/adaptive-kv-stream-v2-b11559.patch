+            }
+            cursor = v_offset+plane_bytes+guard;
+        }
+        if (!ggml_cuda_kv_spans_f16_validate(spans.data(), spans.size(), tokens, heads, pairs*2)) throw std::runtime_error("invalid fixture spans");
