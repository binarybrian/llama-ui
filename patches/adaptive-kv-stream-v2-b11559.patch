+            std::vector<uint8_t> expected(bytes,0xa5);
+            std::fill_n(expected.data()+guard,page.k_bytes,uint8_t(0x31));
+            std::fill_n(expected.data()+guard+page.v_offset,page.v_bytes,uint8_t(0x52));
+            t.assert_true(expected == read);
