+
+    t.test("unknown_domain_flags", [](testing & t) {
+        fixture f;
+        f.domains[0].allocation_classes |= 1u << 31;
+        f.check(t, status::invalid_domain, 1);
+        f = {};
+        f.domains[0].capabilities |= 1u << 31;
