+    constexpr size_t guard = 128;
+    const size_t out_bytes = size_t(dim)*queries*heads*4, fixup_bytes = size_t(blocks)*ncols*(2+dim/2)*sizeof(float2);
+    device_allocation outputs[2] = {device_allocation(out_bytes+2*guard),device_allocation(out_bytes+2*guard)};
+    device_allocation fixups[2] = {device_allocation(fixup_bytes+2*guard),device_allocation(fixup_bytes+2*guard)};
+    std::vector<char> output_bytes[2], metadata[2];
+    for (int implementation = 0; implementation < 2; ++implementation) {
+        check_cuda(cudaMemset(outputs[implementation].data,0x5a,out_bytes+2*guard));
+        check_cuda(cudaMemset(outputs[implementation].data+guard,0,out_bytes));
+        check_cuda(cudaMemset(fixups[implementation].data,0x5a,fixup_bytes+2*guard));
+        check_cuda(cudaMemset(fixups[implementation].data+guard,0,fixup_bytes));
+        auto * out = reinterpret_cast<float *>(outputs[implementation].data+guard);
+        auto * fixup = reinterpret_cast<float2 *>(fixups[implementation].data+guard);
+        const int q1 = dim*4, q2 = queries*q1, q3 = heads*q2;
+        const int k1 = dim*2, k2_stride = capacity*k1, k3 = span_fixture::heads*k2_stride;
+        const int m1 = capacity*2, m2 = queries*m1;
+        const char * k_data = implementation == 0 ? (encoded ? encoded->dense_key.data : key.dense.data) : prototype.data;
+        const char * v_data = implementation == 0 ? (encoded ? encoded->dense_value.data : value.dense.data) : prototype.data;
+#define ATTENTION_ARGS q.data,k_data,v_data,mask.data,nullptr,nullptr,out,fixup, \
+    1.0f/16.0f,0.0f,1.0f,1.0f,0u,0.0f,dim,init_fastdiv_values(queries),heads,1,q1,q2,q3, \
+    dim,capacity,span_fixture::heads,1,k1,k2_stride,int64_t(k3),k1,k2_stride,int64_t(k3), \
+    queries,1,1,m1,m2,int64_t(m2)
+        if (implementation == 0) control_kernel<<<blocks,dim3(32,warps),shared>>>(ATTENTION_ARGS);
+        else span_kernel<<<blocks,dim3(32,warps),span_shared>>>(ATTENTION_ARGS,
+            reinterpret_cast<const ggml_cuda_kv_span *>(encoded ? encoded->descriptors.data : key.descriptors.data),
+            count,int(span_offset),encoded ? encoded->conversion_flags : 3u);
+#undef ATTENTION_ARGS
+        check_cuda(cudaGetLastError());
+        metadata[implementation].resize(fixup_bytes+2*guard);
+        check_cuda(cudaMemcpy(metadata[implementation].data(),fixups[implementation].data,metadata[implementation].size(),cudaMemcpyDeviceToHost));
+        if (blocks%dst_tiles == 0 && blocks > dst_tiles) {
+            flash_attn_stream_k_fixup_uniform<dim,columns,8><<<dim3(dst_tiles,columns,8),dim>>>(
+                out,fixup,queries,heads,span_fixture::heads,blocks,ratio,blocks/dst_tiles,
+                init_fastdiv_values(dst_tiles),init_fastdiv_values(1),init_fastdiv_values(1));
+        } else if (dst_tiles%blocks != 0) {
+            flash_attn_stream_k_fixup_general<dim,columns,8><<<dim3(blocks,columns,8),dim>>>(
+                out,fixup,queries,heads,ratio,tiles*dst_tiles,
+                init_fastdiv_values(tiles*dst_tiles),init_fastdiv_values(tiles),init_fastdiv_values(tiles),init_fastdiv_values(tiles));
+        }
+        check_cuda(cudaGetLastError());
+        output_bytes[implementation].resize(out_bytes+2*guard);
+        check_cuda(cudaMemcpy(output_bytes[implementation].data(),outputs[implementation].data,output_bytes[implementation].size(),cudaMemcpyDeviceToHost));
+        for (const auto * bytes : {&output_bytes[implementation],&metadata[implementation]}) {
+            if (!std::all_of(bytes->begin(),bytes->begin()+guard,[](char x){return x == char(0x5a);}) ||
+                    !std::all_of(bytes->end()-guard,bytes->end(),[](char x){return x == char(0x5a);})) throw std::runtime_error("MMA output or fixup guard changed");
+        }
+    }
+    if (metadata[0] != metadata[1]) throw std::runtime_error("MMA split accumulator or softmax metadata drift");
+    if (output_bytes[0] != output_bytes[1]) throw std::runtime_error("MMA final output bits differ from stock");
+    bool nonzero = false;
+    for (size_t i = 0; i < out_bytes; i += sizeof(float)) {
+        float result;
+        std::memcpy(&result,output_bytes[1].data()+guard+i,sizeof(result));
+        if (!std::isfinite(result)) throw std::runtime_error("nonfinite MMA output");
+        nonzero |= result != 0.0f;
+    }
+    if (!nonzero) throw std::runtime_error("vacuous zero-output attention fixture");
+    key.check_source(); value.check_source();
+    if (encoded) encoded->check_source();
+}
+
+static size_t check_attention_matrix(bool quick) {
+    size_t cases = 0;
+    for (int queries : {1,2,3,4}) for (int active : {31,257,1023,8192}) for (int count : {1,2,3}) {
+        for (bool interleaved : {false,true}) for (int split : {0,1,2}) for (float gain : {1.0f,16.0f}) {
+            if (quick && (active != 257 || count != 3 || interleaved || gain != 1.0f)) continue;
+            try {
+                if (queries == 1) check_attention<1>(queries,active,count,interleaved,split,gain);
+                else if (queries == 2) check_attention<2>(queries,active,count,interleaved,split,gain);
+                else check_attention<4>(queries,active,count,interleaved,split,gain);
+            } catch (...) {
+                std::fprintf(stderr,"MMA case: TG%d active=%d spans=%d interleaved=%d split=%d gain=%g\n",
+                    queries,active,count,int(interleaved),split,double(gain));
+                throw;
+            }
+            ++cases;
+        }
+    }
+    return cases;
+}
+
+template<ggml_type key, ggml_type value>
+static size_t check_encoded_attention_pair(ggml_backend_t backend, bool quick, bool deep) {
+    size_t cases = 0;
+    for (int queries : {2,3,4}) for (int active : {31,257,1023,8192}) for (int count : {1,2,3}) {
+        for (bool interleaved : {false,true}) for (int split : {0,1,2}) for (uint32_t flags : {0u,1u,2u,3u}) {
+            if (!deep && (active != 257 || count != 3 || split || interleaved)) continue;
+            if (quick && (active != 257 || count != 3 || interleaved || split)) continue;
+            quant_span_fixture fixture(backend,key,value,active,(active+255)/256*256,count,interleaved,flags);
+            try {
+                if (queries == 2) check_attention<2,key,value>(queries,active,count,interleaved,split,1.0f,&fixture);
+                else check_attention<4,key,value>(queries,active,count,interleaved,split,1.0f,&fixture);
+            } catch (...) {
+                std::fprintf(stderr,"encoded MMA case: K=%s V=%s TG%d active=%d spans=%d interleaved=%d split=%d flags=%u\n",
+                    ggml_type_name(key),ggml_type_name(value),queries,active,count,int(interleaved),split,flags);
+                throw;
+            }
+            ++cases;
+        }
+    }
+    return cases;
+}
+
+template<ggml_type key>
+static size_t check_encoded_attention_values(ggml_backend_t backend, bool quick) {
+    size_t cases = 0;
+#define CHECK_VALUE(V) cases += check_encoded_attention_pair<key,GGML_TYPE_##V>(backend,quick,key == GGML_TYPE_Q8_0 && GGML_TYPE_##V == GGML_TYPE_Q4_0)
+    CHECK_VALUE(F16); CHECK_VALUE(BF16); CHECK_VALUE(Q8_0); CHECK_VALUE(Q4_0);
+    CHECK_VALUE(Q4_1); CHECK_VALUE(Q5_0); CHECK_VALUE(Q5_1);
+#undef CHECK_VALUE
+    return cases;
+}
+
+template<ggml_type type>
+static size_t check_encoded_tile_type(ggml_backend_t backend, bool quick) {
+    size_t cases = check_encoded_tiles<type,128,false>(backend,quick)+check_encoded_tiles<type,132,false>(backend,quick);
+    cudaDeviceProp properties{};
+    check_cuda(cudaGetDeviceProperties(&properties,0));
+    if (properties.major >= 8) cases += check_encoded_tiles<type,128,true>(backend,quick)+check_encoded_tiles<type,132,true>(backend,quick);
+    return cases;
+}
+
+int main(int argc, char ** argv) {
+    const bool quick = argc == 2 && !std::strcmp(argv[1],"--quick");
+    int devices = 0;
+    if (cudaGetDeviceCount(&devices) != cudaSuccess || devices == 0) return 77;
+    ggml_backend_load_all();
+    ggml_backend_ptr backend(ggml_backend_init_by_name("CUDA0",nullptr));
+    if (!backend) return 77;
+    try {
+        const auto conversion_cases = check_decoding<GGML_TYPE_Q8_0>(backend.get(),quick)+
+            check_decoding<GGML_TYPE_Q4_0>(backend.get(),quick)+check_decoding<GGML_TYPE_Q4_1>(backend.get(),quick)+
+            check_decoding<GGML_TYPE_Q5_0>(backend.get(),quick)+check_decoding<GGML_TYPE_Q5_1>(backend.get(),quick)+
+            check_decoding<GGML_TYPE_F16>(backend.get(),quick)+check_decoding<GGML_TYPE_BF16>(backend.get(),quick);
+        std::printf("Encoded conversion: %zu cases passed, zero byte mismatches\n",conversion_cases);
+        const auto staged_cases = check_encoded_tile_type<GGML_TYPE_Q8_0>(backend.get(),quick)+
+            check_encoded_tile_type<GGML_TYPE_Q4_0>(backend.get(),quick)+check_encoded_tile_type<GGML_TYPE_Q4_1>(backend.get(),quick)+
+            check_encoded_tile_type<GGML_TYPE_Q5_0>(backend.get(),quick)+check_encoded_tile_type<GGML_TYPE_Q5_1>(backend.get(),quick)+
+            check_encoded_tile_type<GGML_TYPE_BF16>(backend.get(),quick)+check_encoded_tile_type<GGML_TYPE_F16>(backend.get(),quick);
+        std::printf("Encoded staging: %zu cases passed, zero byte mismatches\n",staged_cases);
+        const auto quant_attention = check_encoded_attention_values<GGML_TYPE_Q8_0>(backend.get(),quick)+
+            check_encoded_attention_values<GGML_TYPE_Q4_0>(backend.get(),quick)+check_encoded_attention_values<GGML_TYPE_Q4_1>(backend.get(),quick)+
+            check_encoded_attention_values<GGML_TYPE_Q5_0>(backend.get(),quick)+check_encoded_attention_values<GGML_TYPE_Q5_1>(backend.get(),quick)+
+            check_encoded_attention_values<GGML_TYPE_BF16>(backend.get(),quick)+check_encoded_attention_values<GGML_TYPE_F16>(backend.get(),quick);
+        std::printf("Encoded MMA: %zu cases passed, zero output/metadata mismatches\n",quant_attention);
+        size_t cases = check_loads<128,32,false>(quick)+check_loads<132,64,false>(quick);
+        cudaDeviceProp properties{};
+        check_cuda(cudaGetDeviceProperties(&properties,0));
+        if (properties.major >= 8) cases += check_loads<128,32,true>(quick)+check_loads<132,64,true>(quick);
+        std::printf("FP16 span tile probes: %zu cases passed, zero byte mismatches\n",cases);
+        const auto attention_cases = check_attention_matrix(quick);
+        std::printf("FP16 span MMA: %zu cases passed, zero output/metadata mismatches\n",attention_cases);
+    } catch (const std::exception & error) {
+        std::fprintf(stderr,"FP16 span test failed: %s\n",error.what());
+        return 1;
+    }
+}
diff --git a/tests/test-cuda-graph-types.cpp b/tests/test-cuda-graph-types.cpp
new file mode 100644
index 00000000..41a9a9cd
--- /dev/null
+++ b/tests/test-cuda-graph-types.cpp
@@ -0,0 +1,38 @@
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "ggml.h"
+
+#include <cstdio>
+#include <vector>
+
+// Keep source pointers, dimensions and strides unchanged while reusing a captured conversion graph.
+int main() {
+    ggml_backend_load_all();
+    ggml_backend_ptr backend(ggml_backend_init_by_name("CUDA0",nullptr));
+    if (!backend) return 77;
+    ggml_context_ptr context(ggml_init({1024*1024,nullptr,true}));
+    auto * source = ggml_new_tensor_2d(context.get(),GGML_TYPE_F16,256,4);
+    auto * output = ggml_cast(context.get(),source,GGML_TYPE_F32);
+    auto * graph = ggml_new_graph(context.get());
+    ggml_build_forward_expand(graph,output);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(context.get(),backend.get()));
+    if (!buffer) return 1;
+    std::vector<uint16_t> encoded(1024,0x3c00);
+    ggml_backend_tensor_set(source,encoded.data(),0,encoded.size()*sizeof(uint16_t));
+    std::vector<float> actual(1024);
+    for (auto type : {GGML_TYPE_F16,GGML_TYPE_BF16,GGML_TYPE_F16,GGML_TYPE_BF16}) {
+        source->type = type;
+        const float expected = type == GGML_TYPE_F16 ? 1.0f : 0.0078125f;
+        for (int repeat = 0; repeat < 5; ++repeat) {
+            if (ggml_backend_graph_compute(backend.get(),graph) != GGML_STATUS_SUCCESS) return 1;
+            ggml_backend_synchronize(backend.get());
+            ggml_backend_tensor_get(output,actual.data(),0,actual.size()*sizeof(float));
+            for (float value : actual) if (value != expected) {
+                std::fprintf(stderr,"graph source type %s: expected %g, got %g\n",ggml_type_name(type),expected,value);
+                return 1;
+            }
+        }
+    }
+    std::puts("Type-changing graph capture reuse passed");
+    return 0;
+}
diff --git a/tests/test-cuda-kv-host.cpp b/tests/test-cuda-kv-host.cpp
new file mode 100644
index 00000000..a01b9ed6
--- /dev/null
+++ b/tests/test-cuda-kv-host.cpp
@@ -0,0 +1,97 @@
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "testing.h"
+
+#include <cuda_runtime_api.h>
+#include <cstdlib>
+#include <cstring>
+
+using host_type_fn = ggml_backend_buffer_type_t (*)(int);
+using host_register_fn = ggml_backend_buffer_t (*)(int, ggml_backend_buffer_t);
+
+// A mapped allocation must support actual device writes, not just host memcpy.
+static void mapped_write(testing & t, ggml_backend_buffer_t buffer, uint8_t value) {
+    void * host = ggml_backend_buffer_get_base(buffer);
+    void * mapped = nullptr;
+    if (!t.assert_true(cudaHostGetDevicePointer(&mapped, host, 0) == cudaSuccess)) return;
+    t.assert_true(cudaMemset(mapped, value, ggml_backend_buffer_get_size(buffer)) == cudaSuccess);
+    t.assert_true(cudaDeviceSynchronize() == cudaSuccess);
+    auto * bytes = static_cast<uint8_t *>(host);
+    t.assert_true(std::all_of(bytes, bytes + ggml_backend_buffer_get_size(buffer), [value](uint8_t x) { return x == value; }));
+}
+
+int main() {
+    ggml_backend_load_all();
+    auto * reg = ggml_backend_reg_by_name("CUDA");
+    if (!reg || !ggml_backend_reg_dev_count(reg)) return 77;
+    testing t;
+    auto type_fn = reinterpret_cast<host_type_fn>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_host_buffer_type"));
+    auto register_fn = reinterpret_cast<host_register_fn>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_host_buffer_register"));
+    t.test("strict_host_hooks_exist", [&](testing & t) { t.assert_true(type_fn && register_fn); });
+    if (!type_fn || !register_fn) return t.summary();
+    auto * type = type_fn(0);
+    if (!t.assert_true(type != nullptr)) return t.summary();
+    if (std::getenv("GGML_CUDA_NO_PINNED")) {
+        t.test("disabled_pinning_does_not_fall_back", [&](testing & t) {
+            ggml_backend_buffer_ptr owner(ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), 8192));
+            ggml_backend_buffer_ptr allocated(ggml_backend_buft_alloc_buffer(type, 4096));
+            ggml_backend_buffer_ptr registered(register_fn(0, owner.get()));
+            t.assert_true(!allocated && !registered);
+        });
+        return t.summary();
+    }
+    t.test("invalid_devices_and_owners", [&](testing & t) {
+        t.assert_true(type_fn(-1) == nullptr);
+        t.assert_true(type_fn(int(ggml_backend_reg_dev_count(reg))) == nullptr);
+        t.assert_true(register_fn(0, nullptr) == nullptr);
+    });
+    t.test("allocated_mapping_flags_and_last_view_lifetime", [&](testing & t) {
+        ggml_backend_buffer_ptr root(ggml_backend_buft_alloc_buffer(type, 8192));
+        if (!t.assert_true(root != nullptr)) return;
+        t.assert_true(ggml_backend_buffer_get_type(root.get()) == type);
+        t.assert_true(ggml_backend_buffer_is_host(root.get()));
+        unsigned int flags = 0;
+        t.assert_true(cudaHostGetFlags(&flags, ggml_backend_buffer_get_base(root.get())) == cudaSuccess);
+        t.assert_true((flags & cudaHostAllocMapped) != 0);
+#ifdef _WIN32
+        t.assert_true((flags & cudaHostAllocWriteCombined) == 0);
+#else
+        t.assert_true((flags & cudaHostAllocWriteCombined) != 0);
+#endif
+        mapped_write(t, root.get(), 0x31);
+        ggml_backend_buffer_ptr duplicate(register_fn(0, root.get()));
+        t.assert_true(duplicate == nullptr);
+        mapped_write(t, root.get(), 0x32);
+        ggml_backend_buffer_ptr view(ggml_backend_buffer_view(root.get(), 128, 4096));
+        if (!t.assert_true(view != nullptr)) return;
+        root.reset();
+        ggml_backend_buffer_clear(view.get(), 0x52);
+        t.assert_equal(uint8_t(0x52), *static_cast<uint8_t *>(ggml_backend_buffer_get_base(view.get())));
+    });
+    t.test("registered_storage_retains_owner_and_unregisters_once", [&](testing & t) {
+        ggml_backend_buffer_ptr owner(ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), 16384));
+        auto base = reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(owner.get()));
+        size_t offset = (4096 - base % 4096) % 4096;
+        ggml_backend_buffer_ptr page(ggml_backend_buffer_view(owner.get(), offset, 8192));
+        ggml_backend_buffer_ptr registered(register_fn(0, page.get()));
+        if (!t.assert_true(registered != nullptr)) return;
+        mapped_write(t, registered.get(), 0x19);
+        // An existing registration must not be adopted or undone by a failed second registration.
+        ggml_backend_buffer_ptr duplicate(register_fn(0, page.get()));
+        t.assert_true(duplicate == nullptr);
+        mapped_write(t, registered.get(), 0x21);
+        registered.reset();
+        ggml_backend_buffer_ptr again(register_fn(0, page.get()));
+        if (!t.assert_true(again != nullptr)) return;
+        owner.reset(); page.reset();
+        mapped_write(t, again.get(), 0x29);
+    });
+    t.test("allocation_failure_is_recoverable", [&](testing & t) {
+        ggml_backend_buffer_ptr failed(ggml_backend_buft_alloc_buffer(type, SIZE_MAX));
+        t.assert_true(failed == nullptr);
+        t.assert_true(cudaGetLastError() == cudaSuccess);
+        ggml_backend_buffer_ptr valid(ggml_backend_buft_alloc_buffer(type, 4096));
+        if (t.assert_true(valid != nullptr)) mapped_write(t, valid.get(), 0x42);
+    });
+    return t.summary();
+}
diff --git a/tests/test-cuda-vmm-probe.cpp b/tests/test-cuda-vmm-probe.cpp
new file mode 100644
index 00000000..c3f6e91b
--- /dev/null
+++ b/tests/test-cuda-vmm-probe.cpp
@@ -0,0 +1,41 @@
+#include "../ggml/src/ggml-cuda/vmm-probe.h"
+#include "testing.h"
+
+int main() {
+    testing t;
+    t.test("supported_vmm_commits_driver_granularity", [](testing & t) {
+        size_t granularity = 17;
+        size_t queries = 0;
+        const bool available = ggml_cuda_probe_vmm(
+            [&](int & supported) { ++queries; supported = 1; return true; },
+            [&](size_t & bytes) { ++queries; bytes = 65536; return true; }, granularity);
+        t.assert_true(available);
+        t.assert_equal(size_t(2), queries);
+        t.assert_equal(size_t(65536), granularity);
+    });
+    t.test("absent_or_failed_optional_attribute_uses_legacy_pool", [](testing & t) {
+        for (bool success : {false, true}) for (int reported : {0, 1}) {
+            if (success && reported) continue;
+            size_t granularity = 17;
+            size_t queries = 0;
+            const bool available = ggml_cuda_probe_vmm(
+                [&](int & supported) { ++queries; supported = reported; return success; },
+                [&](size_t &) { ++queries; return true; }, granularity);
+            t.assert_true(!available);
+            t.assert_equal(size_t(1), queries);
+            t.assert_equal(size_t(17), granularity);
+        }
+    });
+    t.test("failed_or_zero_granularity_does_not_enable_vmm", [](testing & t) {
+        for (bool success : {false, true}) for (size_t reported : {size_t(0), size_t(65536)}) {
+            if (success && reported) continue;
+            size_t granularity = 17;
+            const bool available = ggml_cuda_probe_vmm(
+                [](int & supported) { supported = 1; return true; },
+                [&](size_t & bytes) { bytes = reported; return success; }, granularity);
+            t.assert_true(!available);
+            t.assert_equal(size_t(17), granularity);
+        }
+    });
+    return t.summary();
+}
diff --git a/tests/test-kv-stream-attention-plan.cpp b/tests/test-kv-stream-attention-plan.cpp
new file mode 100644
index 00000000..a237ca23
--- /dev/null
+++ b/tests/test-kv-stream-attention-plan.cpp
@@ -0,0 +1,229 @@
+#include "../ggml/src/ggml-cuda/kv-stream-attention-plan.h"
+#include "../ggml/src/ggml-cuda/kv-stream-attention-dispatch.h"
+#include "testing.h"
+
+#include <limits>
+#include <utility>
+
+using family = ggml_cuda_kv_stream_kernel_family;
+using style = ggml_cuda_kv_stream_execution_style;
+using status = ggml_cuda_kv_stream_plan_status;
+
+struct fixture {
+    ggml_cuda_kv_stream_attention_metadata metadata{GGML_TYPE_Q8_0, GGML_TYPE_Q4_0, 256, 256, 24, 4, 2, 1023, 1024};
+    ggml_cuda_kv_stream_plan_support support{true, true, true, true, true};
+    ggml_cuda_kv_stream_workspace_requirements requirements{true, 0, 4096, 128, 32768};
+
+    // Failure must not publish a partial replacement of a previously usable descriptor.
+    void reject(testing & t, status expected, family selected = family::vector, style execution = style::resumable) const {
+        ggml_cuda_kv_stream_attention_plan output{};
+        output.family = family::tile;
+        output.style = style::native;
+        output.metadata.active_tokens = 17;
+        output.output_allocation_bytes = 512;
+        output.requirements.scratch_bytes = 128;
+        t.assert_true(ggml_cuda_kv_stream_attention_plan_make(metadata, selected, execution, support, requirements, output) == expected);
+        t.assert_true(output.family == family::tile && output.style == style::native);
+        t.assert_equal(int64_t(17), output.metadata.active_tokens);
+        t.assert_equal(size_t(512), output.output_allocation_bytes);
+        t.assert_equal(size_t(128), output.requirements.scratch_bytes);
+    }
+};
+
+int main() {
+    testing t;
+    t.test("vector_bulk_leaves_only_the_incomplete_native_tile_guarded", [](testing & t) {
