+    GGML_ASSERT(f.content->prepare({{0, ggml_kv_stream_operand::k, 0, bytes.data(), bytes.size()}}, write));
+    GGML_ASSERT(f.content->commit(write));
+    GGML_ASSERT(f.resident->synchronize(1024));
