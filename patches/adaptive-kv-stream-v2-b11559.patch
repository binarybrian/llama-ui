+#!/usr/bin/env python3
+"""Host-only tests for vision memory/latency report accounting."""
+
+import re
+import unittest
+from measure_adaptive_vision import group_phases, parse_phases, parse_reloads, sample_window
+
+
+class Measurements(unittest.TestCase):
