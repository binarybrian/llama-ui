+    });
+
+    t.test("invalid_resource_properties", [](testing & t) {
+        for (uint32_t value : {0u, 3u, 1u << 31}) {
+            fixture f;
+            f.resources[0].allocation_class = static_cast<llama_memory_allocation_class>(value);
+            f.check(t, status::invalid_resource, 1, 11);
