+        t.assert_true(!server_uses_vision_arena(p) && !server_vision_arena_config_error(p));
+    });
+    t.test("serial_embedded_mtp_vision_is_admitted_only_with_bounded_drafting", [](testing & t) {
+        auto p = qualified();
