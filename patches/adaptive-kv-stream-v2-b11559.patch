+        std::vector<ggml_backend_buffer_type_t> types{type,ggml_backend_cpu_buffer_type()};
+        llama_compute_workspace_plan plan;
+        plan.groups = {{type,compute,alignment,0}};
+        plan.phase_sizes = {{compute},{compute}};
