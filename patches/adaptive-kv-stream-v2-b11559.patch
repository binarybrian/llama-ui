+        ggml_kv_stream_partial_batch merged;
+        for (size_t p = 0; p < input.parts; ++p) {
+            ggml_kv_stream_partial_batch part{rows, 1, width, std::vector<float>(rows*width), std::vector<ggml_kv_stream_partial_meta>(rows)};
