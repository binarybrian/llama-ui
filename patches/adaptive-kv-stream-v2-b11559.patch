+struct kv_stream_exact_config {
+    size_t prefill = 16381, rounds = 8, pool_mib = 16;
+    std::filesystem::path corpus = std::filesystem::path(__FILE__).parent_path().parent_path()/"benchmarks/data/online-articles-262144-words.txt";
