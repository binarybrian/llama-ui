+// Construct metadata without allocating buffers. Q is token-major; the output uses GGML's permuted axes.
+struct attention {
+    ggml_tensor q{}, k{}, v{}, mask{}, dst{};
+    ggml_kv_stream_attention_limits limits{256, 256, 256, 256, 128};
