+    def test_multiple_encoded_batches_belong_to_one_request(self):
+        phases = [{"begin_us": 12, "end_us": 15}, {"begin_us": 20, "end_us": 25}, {"begin_us": 35, "end_us": 38}]
+        rows = [{"begin_us": 10, "end_us": 30}, {"begin_us": 32, "end_us": 40}]
