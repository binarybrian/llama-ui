+static bool wait_for_count(const std::atomic<size_t> & count, size_t expected) {
+    for (size_t i = 0; i < 1 << 20; ++i) {
+        if (count.load(std::memory_order_relaxed) >= expected) {
+            return true;
+        }
+        std::this_thread::yield();
+    }
+    return false;
+}
