+    if (strcmp(name, "ggml_backend_cuda_kv_host_buffer_register") == 0) return (void *)ggml_backend_cuda_kv_host_buffer_register;
+    const bool release_graph = strcmp(name, "ggml_backend_cuda_graph_release") == 0;
