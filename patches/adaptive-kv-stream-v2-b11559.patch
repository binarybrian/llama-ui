+    }
+    void run() {
+        if (cuda) { GGML_ASSERT(execution->compute_async({}, 1) == GGML_STATUS_SUCCESS); GGML_ASSERT(execution->drain()); }
+        else GGML_ASSERT(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS);
+    }
+};
