+        }
+        if (!t.assert_true(owner->signal_text_phase({phase,rows,true,true,false}).status == llama_memory_text_phase_status::changed)) return;
+        if (!t.assert_true(owner->prepare_serial_target())) return;
+        auto graph=build(rows);
