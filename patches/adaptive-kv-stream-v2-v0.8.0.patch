+        t.assert_equal(uint32_t(7), common_context_params_to_llama(params).n_rs_seq);
+    });
+
+    t.test("streamed_dflash_model_presence_is_deferred_until_artifact_resolution", [&](testing & t) {
+        auto params = streamed_dflash_params(3, 7);
