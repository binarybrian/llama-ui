+        const int64_t index = 256;
+        ggml_backend_tensor_set(k, row.data(), 0, row.size()*sizeof(float));
+        ggml_backend_tensor_set(v, row.data(), 0, row.size()*sizeof(float));
+        ggml_backend_tensor_set(indices, &index, 0, sizeof(index));
