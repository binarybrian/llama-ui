+    const auto & info = sinfos[i_cur];
+    if (info.empty() || !info.is_contiguous() || info.s0 != 0 || info.s1 != 0 ||
+            info.strm.size() != 1 || info.strm[0] != 0 ||
+            info.head() != cache->tokens() || info.size() != ubatch.n_tokens) return false;
