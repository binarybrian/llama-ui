+        testing t;
+        t.test("d512_feature_pipeline_preserves_order_across_masks_tails_waves_and_rejected_calls", [&](testing & t) {
+            check_d512_pipeline(t,!std::strcmp(argv[1],"--cuda-d512-pipeline-hazards"));
+        });
