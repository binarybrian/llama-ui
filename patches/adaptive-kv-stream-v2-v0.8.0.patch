+static void test_kv_stream_bit_exact_comparator(testing & t) {
+    t.test("bit_exact_comparator_rejects_hidden_numerical_differences", [&](testing & t) {
+        const std::array<uint32_t, 3> reference{0x3f800000, 0, 0x40000000};
+        auto changed = reference;
+        t.assert_true(kv_stream_bytes_equal(reference.data(), sizeof(reference), reference.data(), sizeof(reference)));
+        changed[0]++;
+        t.assert_true(!kv_stream_bytes_equal(reference.data(), sizeof(reference), changed.data(), sizeof(changed)));
+        changed = reference;
+        changed[1] = 0x80000000;
+        t.assert_true(!kv_stream_bytes_equal(reference.data(), sizeof(reference), changed.data(), sizeof(changed)));
+        changed = reference;
+        changed[2] ^= 1;
+        t.assert_true(!kv_stream_bytes_equal(reference.data(), sizeof(reference), changed.data(), sizeof(changed)));
+        t.assert_true(!kv_stream_bytes_equal(reference.data(), sizeof(reference), reference.data(), sizeof(reference)-1));
+        t.assert_true(!kv_stream_bytes_equal(reference.data(), sizeof(reference), nullptr, sizeof(reference)));
+        t.assert_true(kv_stream_bytes_equal(nullptr, 0, nullptr, 0));
+    });
+    t.test("bit_exact_oracle_checks_framing_and_all_chunk_bytes", [&](testing & t) {
+        const auto rejects = [](const std::function<void()> & operation) {
+            try { operation(); } catch (const std::runtime_error &) { return true; }
+            return false;
+        };
+        std::vector<uint8_t> reference(kv_stream_bit_oracle::chunk_bytes + 17, 0xa5);
+        for (int mode = 0; mode < 8; ++mode) {
+            kv_stream_bit_oracle oracle;
+            oracle.bytes("KV", reference.data(), reference.size());
+            oracle.bytes("empty", nullptr, 0);
+            oracle.compare();
+            auto changed = reference;
+            if (mode == 0) {
+                oracle.bytes("KV", reference.data(), reference.size());
+                oracle.bytes("empty", nullptr, 0);
+                oracle.finish();
+                t.assert_equal(size_t(2), oracle.records());
+                t.assert_equal(reference.size(), oracle.byte_count());
+            } else if (mode == 1) {
+                changed[kv_stream_bit_oracle::chunk_bytes] ^= 1;
+                t.assert_true(rejects([&] { oracle.bytes("KV", changed.data(), changed.size()); }));
+            } else if (mode == 2) {
+                t.assert_true(rejects([&] { oracle.bytes("wrong", reference.data(), reference.size()); }));
+            } else if (mode == 3) {
+                t.assert_true(rejects([&] { oracle.bytes("KV", reference.data(), reference.size()-1); }));
+            } else if (mode == 4) {
+                t.assert_true(rejects([&] { oracle.finish(); }));
+            } else if (mode == 5) {
+                oracle.bytes("KV", reference.data(), reference.size());
+                oracle.bytes("empty", nullptr, 0);
+                t.assert_true(rejects([&] { oracle.bytes("extra", nullptr, 0); }));
+            } else {
+                changed[mode == 6 ? 0 : changed.size()-1] ^= 1;
+                t.assert_true(rejects([&] { oracle.bytes("KV", changed.data(), changed.size()); }));
+            }
+        }
+    });
+    t.test("bit_exact_state_ignores_serialization_chunk_boundaries", [&](testing & t) {
+        const std::array<uint8_t, 9> source{1, 2, 3, 4, 5, 6, 7, 8, 9};
+        kv_stream_exact_state whole, split;
+        whole.write(source.data(), source.size());
+        split.write(source.data(), 3);
+        split.write(source.data()+3, source.size()-3);
+        kv_stream_bit_oracle oracle;
+        whole.compare_with(oracle, "recurrent");
+        oracle.compare();
+        split.compare_with(oracle, "recurrent");
+        oracle.finish();
+        t.assert_equal(source.size(), whole.n_bytes());
+        t.assert_equal(source.size(), split.n_bytes());
+        bool rejected = false;
+        try { split.write(nullptr, 1); } catch (const std::runtime_error &) { rejected = true; }
+        t.assert_true(rejected);
+    });
+    t.test("default_exact_pool_can_hold_the_complete_auxiliary_history", [&](testing & t) {
+        const kv_stream_exact_config config;
+        const size_t capacity = (config.prefill+config.rounds*4+255)/256*256;
+        ggml_kv_stream_layout layer;
+        t.assert_true(ggml_kv_stream_layout_make({config.key,config.value,256,256,4,256,128},capacity,layer).status ==
+            ggml_kv_stream_status::success);
+        t.assert_true(config.pool_mib*1048576 >= layer.bytes);
+    });
+    t.test("MTP_control_files_require_one_explicit_profile_and_one_direction", [&](testing & t) {
+        const auto parse=[](std::vector<std::string> fields) {
+            std::vector<char *> args;
+            for (auto & field:fields) args.push_back(field.data());
+            return kv_stream_exact_arguments(int(args.size()),args.data());
+        };
+        const auto out=parse({"test","--model","model","--mtp-bit-exact","--exact-length","3",
+            "--exact-control-export","native.bin"});
+        t.assert_equal(std::string("native.bin"),out.control_export.string());
+        const auto in=parse({"test","--model","model","--mtp-bit-exact","--exact-length","3",
+            "--exact-control-import","native.bin"});
+        t.assert_equal(std::string("native.bin"),in.control_import.string());
+        for (const auto & tail:std::vector<std::vector<std::string>>{
+                {"--exact-control-export","native.bin"},
+                {"--exact-length","3","--exact-control-export",""},
+                {"--exact-length","3","--exact-control-export","native.bin","--exact-control-import","native.bin"},
+                {"--exact-length","3","--exact-control-import"}}) {
+            std::vector<std::string> fields{"test","--model","model","--mtp-bit-exact"};
+            fields.insert(fields.end(),tail.begin(),tail.end());
+            bool rejected=false;
+            try { parse(fields); } catch (const std::exception &) { rejected=true; }
+            t.assert_true(rejected);
+        }
+    });
+    t.test("bit_exact_arguments_accept_explicit_cache_formats", [&](testing & t) {
+        std::vector<std::string> fields{"test", "--model", "model", "--mtp-bit-exact",
+            "--test-cache-k", "q5_1", "--test-cache-v", "q8_0"};
+        std::vector<char *> arguments;
+        for (auto & field : fields) arguments.push_back(field.data());
+        const auto config = kv_stream_exact_arguments(int(arguments.size()), arguments.data());
+        t.assert_equal(size_t(16381), config.prefill);
+        t.assert_equal(size_t(256), config.batch_rows);
+        t.assert_equal(size_t(0), config.length);
+        t.assert_true(config.key == GGML_TYPE_Q5_1 && config.value == GGML_TYPE_Q8_0);
+        for (auto key : {"f32", "f16", "bf16", "q8_0", "q5_0", "q5_1", "q4_0", "q4_1", "iq4_nl"})
+            for (auto value : {"f32", "f16", "bf16", "q8_0", "q5_0", "q5_1", "q4_0", "q4_1", "iq4_nl"}) {
+                fields[5] = key; fields[7] = value;
+                arguments.clear();
+                for (auto & field : fields) arguments.push_back(field.data());
+                const auto pair = kv_stream_exact_arguments(int(arguments.size()), arguments.data());
+                t.assert_equal(std::string(key), std::string(ggml_type_name(pair.key)));
+                t.assert_equal(std::string(value), std::string(ggml_type_name(pair.value)));
+            }
+    });
+    t.test("exact_microbatch_profile_can_isolate_ring_from_reclaimed_prefill_memory", [&](testing & t) {
+        std::vector<std::string> fields{"test", "--model", "model", "--mtp-bit-exact",
+            "--exact-batch-size", "8", "--exact-length", "3"};
+        std::vector<char *> arguments;
+        for (auto & field : fields) arguments.push_back(field.data());
+        const auto config = kv_stream_exact_arguments(int(arguments.size()), arguments.data());
+        t.assert_equal(size_t(16381), config.prefill);
+        t.assert_equal(size_t(8), config.batch_rows);
+        t.assert_equal(size_t(3), config.length);
+    });
+    t.test("bit_exact_arguments_reject_unbounded_or_incomplete_profiles", [&](testing & t) {
+        const auto rejects = [](std::vector<std::string> fields) {
+            std::vector<char *> argv;
+            for (auto & field : fields) argv.push_back(field.data());
+            try { kv_stream_exact_arguments(int(argv.size()), argv.data()); }
+            catch (const std::exception &) { return true; }
+            return false;
+        };
+        for (const char * value : {"0", "-1", "32769", "18446744073709551616", "16381junk"})
+            t.assert_true(rejects({"test", "--model", "model", "--mtp-bit-exact", "--exact-prefill", value}));
+        t.assert_true(rejects({"test", "--model", "model", "--mtp-bit-exact", "--exact-rounds", "3"}));
+        t.assert_true(rejects({"test", "--model", "model", "--mtp-bit-exact", "--exact-pool-mib", "1025"}));
+        for (const char * value : {"0", "3", "4", "257"})
+            t.assert_true(rejects({"test", "--model", "model", "--mtp-bit-exact", "--exact-batch-size", value}));
+        for (const char * value : {"0", "4"})
+            t.assert_true(rejects({"test", "--model", "model", "--mtp-bit-exact", "--exact-length", value}));
+        t.assert_true(rejects({"test", "--model", "model", "--mtp-bit-exact", "--exact-prefill"}));
+        t.assert_true(rejects({"test", "--model", "model", "--mtp-bit-exact", "--unknown"}));
+        for (const char * value : {"q8_1", "q2_k", "i32", "", "unknown"})
+            t.assert_true(rejects({"test", "--model", "model", "--mtp-bit-exact", "--test-cache-k", value}));
+    });
+    t.test("bit_exact_corpus_is_bounded_before_allocation", [&](testing & t) {
+        std::istringstream valid("article");
+        t.assert_equal(std::string("article"), kv_stream_exact_text(valid));
+        std::istringstream empty;
+        bool rejected = false;
+        try { kv_stream_exact_text(empty); } catch (const std::runtime_error &) { rejected = true; }
+        t.assert_true(rejected);
+        struct oversized : std::streambuf {
+            pos_type seekoff(off_type, std::ios_base::seekdir, std::ios_base::openmode) override {
+                return pos_type(std::streamoff(64*1048576+1));
+            }
+            int_type underflow() override { throw std::logic_error("oversized corpus was read"); }
+        } buffer;
+        std::istream huge(&buffer);
+        rejected = false;
+        try { kv_stream_exact_text(huge); } catch (const std::runtime_error &) { rejected = true; }
+        t.assert_true(rejected);
+        std::istream nonseekable(nullptr);
+        rejected = false;
+        try { kv_stream_exact_text(nonseekable); } catch (const std::runtime_error &) { rejected = true; }
+        t.assert_true(rejected);
+    });
+}
diff --git a/tests/kv-stream-block-test.h b/tests/kv-stream-block-test.h
new file mode 100644
index 00000000..ab4561c5
--- /dev/null
+++ b/tests/kv-stream-block-test.h
@@ -0,0 +1,93 @@
+#pragma once
+#include "kv-stream-resident-test.h"
+#include "../ggml/src/ggml-kv-stream-device.h"
+
+struct block_workspace {
+    arena_ptr arena{nullptr, ggml_backend_memory_arena_free};
+    lease_ptr lease{nullptr, ggml_backend_memory_lease_free};
+    // Exercise an exact-sized lease at a nonzero parent offset.
+    block_workspace(fixture & f, size_t bytes, uint64_t id = 19) {
+        auto * type = f.cuda ? llama_kv_stream_device_buffer_type(ggml_backend_get_device(f.backend)) : ggml_backend_cpu_buffer_type();
+        arena.reset(ggml_backend_memory_arena_new(type, bytes + 256));
+        GGML_ASSERT(arena && ggml_backend_memory_arena_begin(arena.get(), 0));
+        const auto base = reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(ggml_backend_memory_arena_parent(arena.get())));
+        GGML_ASSERT(ggml_backend_memory_arena_reserve_at(arena.get(), id, 128 + (128-base%128)%128, bytes, 64, 0, nullptr));
+        GGML_ASSERT(ggml_backend_memory_arena_commit(arena.get()));
+        lease.reset(ggml_backend_memory_arena_acquire(arena.get(), id));
+    }
+};
+
+struct block_inputs {
+    ggml_context_ptr context;
+    ggml_backend_buffer_ptr buffer;
+    ggml_tensor * q, * mask, * output;
+    std::vector<float> qdata;
+    size_t active, queries, padded, query_heads, value_width;
+    // Keep the full causal-mask row pitch while the two attention calls use separate key slices.
+    block_inputs(fixture & f, size_t active, size_t queries, bool masked = false, size_t query_heads = 4,
+            ggml_backend_buffer_t workspace = nullptr) : active(active), queries(queries), padded((active+255)/256*256), query_heads(query_heads), value_width(size_t(f.policy.shape.head_dim_v)) {
+        context.reset(ggml_init({65536, nullptr, true}));
+        q = ggml_new_tensor_3d(context.get(), GGML_TYPE_F32, f.policy.shape.head_dim_k, int64_t(queries), int64_t(query_heads));
+        mask = ggml_new_tensor_2d(context.get(), GGML_TYPE_F16, int64_t(padded), int64_t(queries));
+        output = ggml_new_tensor_3d(context.get(), GGML_TYPE_F32, int64_t(value_width), int64_t(query_heads), int64_t(queries));
+        if (workspace) {
+            buffer.reset(ggml_backend_buffer_retain(workspace));
+            ggml_tallocr allocator;
+            GGML_ASSERT(ggml_tallocr_new_range(&allocator,workspace,0,ggml_backend_buffer_get_size(workspace)));
+            for (auto * tensor : {q,mask,output}) GGML_ASSERT(ggml_tallocr_alloc(&allocator,tensor) == GGML_STATUS_SUCCESS);
+        } else buffer.reset(ggml_backend_alloc_ctx_tensors(context.get(), f.backend));
+        GGML_ASSERT(buffer);
+        qdata.resize(queries*query_heads*size_t(f.policy.shape.head_dim_k));
+        for (size_t i = 0; i < qdata.size(); ++i) qdata[i] = .3f*std::cos(float(i%211)*.07f);
+        std::vector<ggml_fp16_t> masks(padded*queries);
+        for (size_t query = 0; query < queries; ++query) for (size_t token = 0; token < padded; ++token)
+            masks[query*padded+token] = ggml_fp32_to_fp16(!masked && token <= active-queries+query ? 0 : -INFINITY);
+        ggml_backend_tensor_set(q, qdata.data(), 0, qdata.size()*sizeof(float));
+        ggml_backend_tensor_set(mask, masks.data(), 0, masks.size()*sizeof(ggml_fp16_t));
+        std::vector<float> sentinel(queries*query_heads*value_width, -77);
+        ggml_backend_tensor_set(output, sentinel.data(), 0, sentinel.size()*sizeof(float));
+    }
+    // Read only the public output, not intermediate or padded scratch bytes.
+    std::vector<float> read() const {
+        std::vector<float> result(queries*query_heads*value_width);
+        ggml_backend_tensor_get(output, result.data(), 0, result.size()*sizeof(float));
+        return result;
+    }
+};
+
+inline std::vector<float> stock_attention(fixture & f, block_inputs & input, uint32_t layer, float scale = 1.0f/16,
+        bool (*native_override)(ggml_backend_t,ggml_tensor *) = nullptr) {
+    ggml_context_ptr ctx(ggml_init({65536,nullptr,true}));
+    const int64_t kv_heads=f.policy.shape.heads;
+    const int64_t dk=f.policy.shape.head_dim_k, dv=f.policy.shape.head_dim_v;
+    auto * k=ggml_new_tensor_2d(ctx.get(),ggml_type(f.policy.shape.type_k),dk*kv_heads,input.padded);
+    auto * v=ggml_new_tensor_2d(ctx.get(),ggml_type(f.policy.shape.type_v),dv*kv_heads,input.padded);
+    auto * key=ggml_view_3d(ctx.get(),k,dk,input.padded,kv_heads,ggml_row_size(k->type,dk*kv_heads),ggml_row_size(k->type,dk),0);
+    auto * value=ggml_view_3d(ctx.get(),v,dv,input.padded,kv_heads,ggml_row_size(v->type,dv*kv_heads),ggml_row_size(v->type,dv),0);
+    auto * out=ggml_flash_attn_ext(ctx.get(),input.q,key,value,input.mask,scale,0,0);
+    ggml_flash_attn_ext_set_prec(out,GGML_PREC_F32);
+    auto * graph=ggml_new_graph_custom(ctx.get(),64,false); ggml_build_forward_expand(graph,out);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(ctx.get(),f.backend)); GGML_ASSERT(buffer);
+    llama_kv_stream_host_layer host; GGML_ASSERT(f.host->layer(layer,host));
+    ggml_backend_tensor_set(k,host.k,0,ggml_nbytes(k)); ggml_backend_tensor_set(v,host.v,0,ggml_nbytes(v));
+    GGML_ASSERT(ggml_backend_graph_compute(f.backend,graph) == GGML_STATUS_SUCCESS);
+    if (native_override) GGML_ASSERT(native_override(f.backend,out));
+    std::vector<float> result(ggml_nelements(out)); ggml_backend_tensor_get(out,result.data(),0,ggml_nbytes(out)); return result;
+}
+
+inline bool same_float_bits(const std::vector<float> & expected, const std::vector<float> & actual) {
+    return expected.size() == actual.size() &&
+        std::memcmp(expected.data(),actual.data(),expected.size()*sizeof(float)) == 0;
+}
+
+// Check finiteness before measuring the worst absolute error.
+static void close_values(testing & t, const std::vector<float> & expected, const std::vector<float> & actual, float tolerance) {
+    if (!t.assert_equal(expected.size(), actual.size())) return;
+    float error = 0;
+    for (size_t i = 0; i < expected.size(); ++i) {
+        if (!std::isfinite(actual[i])) { t.assert_true(false); return; }
+        error = std::max(error, std::abs(actual[i]-expected[i]));
+    }
+    t.out << "max absolute error = " << error << '\n';
+    t.assert_true(error < tolerance);
+}
diff --git a/tests/kv-stream-capture-native.cu b/tests/kv-stream-capture-native.cu
new file mode 100644
index 00000000..949dae4c
--- /dev/null
+++ b/tests/kv-stream-capture-native.cu
@@ -0,0 +1,18 @@
+#include "../ggml/src/ggml-cuda/common.cuh"
+#include "../ggml/src/ggml-backend-impl.h"
+
+// Test-only access to the backend's actual primary stream; no native handles enter the llama API.
+void kv_capture_test_begin(ggml_backend_t backend) {
+    ggml_backend_synchronize(backend);
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    GGML_ASSERT(cudaSetDevice(ctx->device) == cudaSuccess);
+    const auto stream = ctx->streams[ctx->device][ctx->curr_stream_no];
+    GGML_ASSERT(stream && cudaStreamBeginCapture(stream,cudaStreamCaptureModeThreadLocal) == cudaSuccess);
+}
+bool kv_capture_test_end(ggml_backend_t backend) {
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    cudaGraph_t graph = nullptr;
+    const auto status = cudaStreamEndCapture(ctx->streams[ctx->device][ctx->curr_stream_no],&graph);
+    if (graph) GGML_ASSERT(cudaGraphDestroy(graph) == cudaSuccess);
+    return status == cudaSuccess;
+}
diff --git a/tests/kv-stream-dflash-test.h b/tests/kv-stream-dflash-test.h
new file mode 100644
index 00000000..0b2e5b40
--- /dev/null
+++ b/tests/kv-stream-dflash-test.h
@@ -0,0 +1,891 @@
+#pragma once
+
+#include "kv-stream-bit-exact-test.h"
+#include "../src/llama-kv-cache-iswa.h"
+
+#include <set>
+
+static void test_dflash_prefetch_intent(testing & t, llama_model * model, const char * sidecar) {
+    for (bool custom : {true, false}) {
+        auto cp = llama_context_default_params();
+        cp.n_ctx = custom ? 4096 : 8192; cp.n_batch = cp.n_ubatch = 256;
+        cp.n_seq_max = 1; cp.n_rs_seq = 7;
+        cp.n_outputs_max = cp.n_outputs_max_per_seq = 8;
+        cp.type_k = GGML_TYPE_Q8_0; cp.type_v = GGML_TYPE_Q4_0;
+        cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+        cp.shared_device_memory_bytes = size_t(custom ? 1024 : 228)*1024*1024;
+        context_ptr target(llama_init_from_model(model, cp), llama_free);
+        if (!t.assert_true(bool(target))) return;
+        auto * hybrid = dynamic_cast<llama_memory_hybrid *>(llama_get_memory(target.get()));
+        auto * source = hybrid ? hybrid->get_mem_attn()->get_kv_stream() : nullptr;
+        if (!t.assert_true(source != nullptr)) return;
+        const auto initial_append = source->next_consumer(llama_kv_stream_access_role::append);
+        const auto initial_read = source->next_consumer(llama_kv_stream_access_role::read);
+        llama_kv_stream_next_consumer previous;
+        previous.cache_id = custom ? source->host()->cache_id() : 0; previous.future_tokens = custom ? 3 : 0;
+        if (!t.assert_true(source->schedule_next_consumer(llama_kv_stream_access_role::append, previous))) return;
+        auto previous_read = previous; previous_read.cache_id = source->host()->cache_id(); previous_read.future_tokens = 1;
+        if (!t.assert_true(source->schedule_next_consumer(llama_kv_stream_access_role::read, previous_read))) return;
+        common_params base;
+        base.n_ctx = cp.n_ctx; base.n_batch = base.n_ubatch = 256;
+        base.n_parallel = 1; base.n_gpu_layers = 999;
+        base.shared_device_memory_bytes = cp.shared_device_memory_bytes;
+        base.fit_params = false;
+        base.cache_type_k = cp.type_k; base.cache_type_v = cp.type_v;
+        base.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+        base.speculative.types = {COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH};
+        if (custom) base.speculative.types.push_back(COMMON_SPECULATIVE_TYPE_NGRAM_MAP_K4V);
+        base.speculative.draft.n_max = 3; base.speculative.draft.n_min = 0; base.speculative.draft.p_min = 0;
+        base.speculative.draft.n_gpu_layers = 999; base.speculative.draft.mparams.path = sidecar;
+        base.speculative.ngram_map_k4v.size_m = 7;
+        auto params = common_base_params_to_speculative(base);
+        params.n_ubatch = 8;
+        auto owned = common_speculative_init_from_params(params, model, target.get());
+        if (!t.assert_true(owned && owned->context())) return;
+        const auto flexible = [&] {
+            const auto next = source->next_consumer(llama_kv_stream_access_role::append);
+            return next.access == llama_kv_stream_access_role::append &&
+                next.cache_id == source->host()->cache_id() && next.future_tokens == 0;
+        };
+        if (!t.assert_true("serial block drafter owns flexible next-target prefetch", flexible())) return;
+        auto * parent = target->get_compute_memory()->shared_parent();
+        params.speculative.draft.ctx_tgt = target.get();
+        params.speculative.draft.ctx_dft = owned->context();
+        common_speculative_ptr first(common_speculative_init(params.speculative, 1));
+        common_speculative_ptr second(common_speculative_init(params.speculative, 1));
+        if (!t.assert_true(first && second && flexible())) return;
+        first.reset();
+        t.assert_true("one probe driver cannot remove the context owner's prefetch intent", flexible());
+        size_t position = 0;
+        if (!custom) {
+            const auto submit = [&](size_t rows, bool decode) {
+                common_batch batch(target.get());
+                for (size_t i = 0; i < rows; ++i) batch.add(1000+llama_token((position+i)%17),
+                    llama_pos(position+i), 0, decode || i+1 == rows);
+                llama_set_kv_stream_decode(target.get(), decode);
+                if (!t.assert_equal(0, llama_process(target.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get())) ||
+                        !t.assert_true(common_speculative_process(second.get(), batch))) return false;
+                position += rows;
+                return true;
+            };
+            while (position < 6143) if (!submit(std::min(size_t(256),6143-position), false)) return;
+            if (!submit(1, true)) return;
+            t.assert_true("lookahead does not cross a physical KV layout boundary", !source->prefetch_primed());
+            if (!submit(1, true)) return;
+            if (!t.assert_true("the committed ring source is primed for a variable verification width", source->prefetch_primed())) return;
+            if (!submit(8, true)) return;
+            llama_synchronize(target.get()); llama_synchronize(owned->context());
+            llama_kv_stream_runtime_diagnostics diagnostics;
+            if (!t.assert_true(source->runtime_diagnostics(diagnostics) && diagnostics.streaming_active)) return;
+            t.assert_true("actual TG8 adopts the existing flexible ring prime",
+                source->sequence_stats(llama_kv_stream_access_role::append).adopted);
+            t.assert_true("child teardown is exercised with a retained idle prime", source->prefetch_primed());
+        }
+        second.reset();
+        t.assert_true("prefetch intent outlives all drivers sharing its owned child", flexible());
+        owned.reset();
+        const auto restored = source->next_consumer(llama_kv_stream_access_role::append);
+        const auto restored_read = source->next_consumer(llama_kv_stream_access_role::read);
+        t.assert_equal(previous.cache_id, restored.cache_id);
+        t.assert_equal(previous.future_tokens, restored.future_tokens);
+        t.assert_equal(previous_read.cache_id, restored_read.cache_id);
+        t.assert_equal(previous_read.future_tokens, restored_read.future_tokens);
+        t.assert_true(!target->get_compute_memory()->has_speculative_consumer());
+        t.assert_true(parent == target->get_compute_memory()->shared_parent());
+        params.speculative.draft.ctx_dft = nullptr;
+        auto invalid = params;
+        invalid.speculative.draft.n_max = 8;
+        bool rejected = false;
+        try { auto failure = common_speculative_init_from_params(invalid, model, target.get()); }
+        catch (const std::invalid_argument &) { rejected = true; }
+        t.assert_true("failed admission preserves the previous prefetch owner", rejected &&
+            source->next_consumer(llama_kv_stream_access_role::append).future_tokens == previous.future_tokens &&
+            source->next_consumer(llama_kv_stream_access_role::read).future_tokens == previous_read.future_tokens &&
+            !target->get_compute_memory()->has_speculative_consumer());
+        t.assert_true(source->schedule_next_consumer(llama_kv_stream_access_role::append, initial_append));
+        t.assert_true(source->schedule_next_consumer(llama_kv_stream_access_role::read, initial_read));
+        common_batch resumed(target.get()); resumed.add(1000, llama_pos(position), 0, true);
+        llama_set_kv_stream_decode(target.get(), true);
+        if (!t.assert_equal(0, llama_process(target.get(), LLAMA_PROCESS_TYPE_DECODE, resumed.get()))) return;
+        llama_synchronize(target.get());
+        const auto * logits = llama_get_logits_ith(target.get(), -1);
+        const auto vocab = size_t(llama_vocab_n_tokens(llama_model_get_vocab(model)));
+        t.assert_true(logits && std::all_of(logits, logits+vocab, [](float x) { return std::isfinite(x); }));
+    }
+}
+
+static llama_context_params dflash_independent_child_params(llama_context_params target, llama_context * parent) {
+    target.shared_device_memory_bytes = 0;
+    target.n_rs_seq = 0;
+    target.swa_full = false;
+    target.n_outputs_max = target.n_outputs_max_per_seq = 4;
+    target.ctx_other = parent;
+    return target;
+}
+
+static void test_dflash_independent_quota(testing & t, llama_model * model, const char * sidecar) {
+    auto mp = llama_model_default_params();
+    mp.n_gpu_layers = 999;
+    model_ptr draft_model(llama_model_load_from_file(sidecar, mp), llama_model_free);
+    if (!t.assert_true(bool(draft_model))) return;
+    auto cp = llama_context_default_params();
+    cp.n_ctx = 4096; cp.n_batch = cp.n_ubatch = 256;
+    cp.n_seq_max = 1; cp.n_rs_seq = 7; cp.n_outputs_max = cp.n_outputs_max_per_seq = 8;
+    cp.type_k = GGML_TYPE_Q8_0; cp.type_v = GGML_TYPE_Q4_0;
+    cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    cp.shared_device_memory_bytes = size_t(512)*1024*1024;
+    const auto make_draft_params = [&](llama_context * target) {
+        return dflash_independent_child_params(cp,target);
+    };
+    const auto exercise = [&](llama_context * target, llama_context * child) {
+        common_params_speculative params;
+        params.types = {COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH};
+        params.draft.n_max = 3; params.draft.n_min = 0; params.draft.p_min = 0;
+        params.draft.ctx_tgt = target; params.draft.ctx_dft = child;
+        common_speculative_ptr spec(common_speculative_init(params, 1));
+        if (!t.assert_true(bool(spec))) return false;
+        const auto seed = common_tokenize(target, "A bounded serial resource and rollback control. ", true);
+        if (!t.assert_true(!seed.empty())) return false;
+        llama_tokens history;
+        const auto submit = [&](size_t first, size_t rows, bool decode) {
+            common_batch batch(target);
+            for (size_t i=0;i<rows;++i) batch.add(seed[(first+i)%seed.size()],llama_pos(first+i),0,decode || i+1 == rows);
+            llama_set_kv_stream_decode(target,decode);
+            if (!t.assert_equal(0,llama_process(target,LLAMA_PROCESS_TYPE_DECODE,batch.get()))) return false;
+            if (!t.assert_true(common_speculative_process(spec.get(),batch))) return false;
+            llama_synchronize(target); llama_synchronize(child);
+            for (size_t i=0;i<rows;++i) history.push_back(seed[(first+i)%seed.size()]);
+            return true;
+        };
+        if (!submit(0,16,false)) return false;
+        llama_tokens proposed;
+        auto & request = common_speculative_get_draft_params(spec.get(),0);
+        request.drafting=true; request.n_max=3; request.pos0=16;
+        request.id_last=seed[16%seed.size()]; request.prompt=&history; request.result=&proposed;
+        common_speculative_draft(spec.get()); llama_synchronize(child);
+        if (!t.assert_equal(size_t(3),proposed.size())) return false;
+        if (!t.assert_true(llama_memory_seq_rm(llama_get_memory(child),0,16,-1))) return false;
+        if (!submit(16,1,false) || !submit(17,8,true)) return false;
+        const auto vocab = size_t(llama_vocab_n_tokens(llama_model_get_vocab(model)));
+        for (int row=0;row<8;++row) {
+            const auto * logits = llama_get_logits_ith(target,row);
+            if (!t.assert_true(logits && std::all_of(logits,logits+vocab,[](float value) { return std::isfinite(value); }))) return false;
+        }
+        if (!t.assert_true(llama_memory_seq_rm(llama_get_memory(target),0,18,-1) &&
+                llama_memory_seq_rm(llama_get_memory(child),0,18,-1))) return false;
+        history.resize(18);
+        auto * hybrid=dynamic_cast<llama_memory_hybrid *>(llama_get_memory(target));
+        auto * recurrent=hybrid ? hybrid->get_mem_recr() : nullptr;
+        if (!t.assert_true(recurrent && recurrent->rs_idx[0]==7)) return false;
+        const auto generation=recurrent->spill_generation();
+        proposed.clear(); request.drafting=true; request.n_max=3; request.pos0=18;
+        request.id_last=seed[18%seed.size()]; request.prompt=&history; request.result=&proposed;
+        common_speculative_draft(spec.get()); llama_synchronize(child);
+        if (!t.assert_equal(size_t(3),proposed.size())) return false;
+        if (!t.assert_true("a successor draft enqueues the selected target restore before target re-entry",recurrent->rs_idx[0]==0)) return false;
+        t.assert_equal(generation,recurrent->spill_generation());
+        if (!t.assert_true(llama_memory_seq_rm(llama_get_memory(child),0,18,-1))) return false;
+        return submit(18,1,false);
+    };
+    size_t exact = 0;
+    {
+        context_ptr target(new llama_context(*model,cp),llama_free);
+        const auto features = target->get_cparams().embeddings_layer_inp;
+        const auto revision = target->get_compute_memory()->graph_binding_revision();
+        for (uint32_t rows : {1u, 9u}) {
+            bool rejected = false;
+            try {
+                context_ptr invalid(new llama_context(*draft_model,make_draft_params(target.get()),rows),llama_free);
+            } catch (const std::runtime_error & error) {
+                rejected = std::string(error.what()).find("incompatible serial DFlash2 context") != std::string::npos;
+            }
+            t.assert_true("invalid prediction bounds reject before target mutation", rejected);
+            t.assert_equal(revision, target->get_compute_memory()->graph_binding_revision());
+            t.assert_true(features == target->get_cparams().embeddings_layer_inp);
+        }
+        context_ptr child(new llama_context(*draft_model,make_draft_params(target.get()),4),llama_free);
+        if (!exercise(target.get(),child.get())) return;
+        auto * hybrid = dynamic_cast<llama_memory_hybrid *>(llama_get_memory(target.get()));
+        auto * stream = hybrid ? hybrid->get_mem_attn()->get_kv_stream() : nullptr;
+        if (!t.assert_true(stream != nullptr)) return;
+        const auto & config = stream->host()->config();
+        llama_kv_stream_policy_config policy;
+        policy.shape=config.shape; policy.capabilities=config.capabilities; policy.layers=config.layers;
+        llama_context_memory_diagnostics usage;
+        size_t minimum = 0;
+        if (!t.assert_true(target->get_compute_memory()->diagnostics(usage) && usage.unused_bytes == 0 &&
+                usage.phase == llama_memory_text_phase::prefill &&
+                llama_kv_stream_policy_minimum_pool_bytes(policy,minimum).status == llama_kv_stream_policy_status::success &&
+                minimum <= usage.kv_pool_bytes && usage.kv_pool_bytes <= usage.parent_bytes)) return;
+        exact=usage.parent_bytes-usage.kv_pool_bytes+minimum;
+        std::fprintf(stderr,"DFlash independent quota: target_rows=8 prediction_rows=4 required=%zu minimum_pool=%zu\n",exact,minimum);
+    }
+    if (!t.assert_true(exact > 1)) return;
+    for (bool sufficient : {false,true}) {
+        cp.shared_device_memory_bytes=exact-(sufficient ? 0 : 1);
+        context_ptr target(nullptr,llama_free),child(nullptr,llama_free);
+        std::string error;
+        try {
+            target.reset(new llama_context(*model,cp));
+            child.reset(new llama_context(*draft_model,make_draft_params(target.get()),4));
+        } catch (const std::runtime_error & failure) {
+            error=failure.what();
+        }
+        if (!sufficient) {
+            const auto fields=error.find("required=");
+            size_t required=0,available=0,additional=0;
+            if (!t.assert_true("one-byte-short DFlash joint quota rejects with exact cause and no private fallback",
+                    error.find("insufficient arena quota") != std::string::npos && fields != std::string::npos &&
+                    std::sscanf(error.c_str()+fields,"required=%zu, available=%zu, additional=%zu",&required,&available,&additional)==3)) {
+                t.out << "DFlash short quota error: " << error << '\n'; return;
+            }
+            t.assert_equal(exact,required); t.assert_equal(exact-1,available); t.assert_equal(size_t(1),additional);
+            continue;
+        }
+        if (!t.assert_true("exact DFlash joint quota admits both contexts",error.empty() && target && child)) {
+            t.out << "DFlash exact quota error: " << error << '\n'; return;
+        }
+        t.assert_equal(exact,target->get_compute_memory()->shared_parent_capacity());
+        t.assert_true(target->get_compute_memory()->shared_parent() == child->get_compute_memory()->shared_parent());
+        t.assert_equal(uint32_t(4),child->get_cparams().serial_block_rows);
+        t.assert_equal(uint32_t(8),target->get_cparams().kv_stream_decode_rows());
+        if (!exercise(target.get(),child.get())) return;
+        auto * parent=target->get_compute_memory()->shared_parent();
+        child.reset();
+        t.assert_true(!target->get_compute_memory()->has_speculative_consumer());
+        t.assert_true(parent==target->get_compute_memory()->shared_parent());
+        const auto next=llama_memory_seq_pos_max(llama_get_memory(target.get()),0)+1;
+        common_batch resumed(target.get());
+        resumed.add(1000,next,0,true);
+        llama_set_kv_stream_decode(target.get(),true);
+        if (!t.assert_equal(0,llama_process(target.get(),LLAMA_PROCESS_TYPE_DECODE,resumed.get()))) return;
+        t.assert_equal(next,llama_memory_seq_pos_max(llama_get_memory(target.get()),0));
+    }
+}
