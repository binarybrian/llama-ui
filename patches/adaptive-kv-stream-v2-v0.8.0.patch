+int main(int argc, char ** argv) {
+    const bool long_benchmark=argc == 2 && !std::strcmp(argv[1],"--benchmark-long");
+    benchmark_mma=long_benchmark || (argc == 2 && !std::strcmp(argv[1],"--benchmark"));
+    if (long_benchmark) benchmark_tokens=131072;
+    const bool quick = argc == 2 && !std::strcmp(argv[1],"--quick");
+    int devices = 0;
+    if (cudaGetDeviceCount(&devices) != cudaSuccess || devices == 0) return 77;
+    ggml_backend_load_all();
+    ggml_backend_ptr backend(ggml_backend_init_by_name("CUDA0",nullptr));
+    if (!backend) return 77;
+    try {
+        if (argc == 2 && !std::strcmp(argv[1],"--prefill-only")) {
+            for (int queries : {9,16,64,129,256,512,1024}) {
+                check_prefill_requirements(backend.get(),queries,GGML_TYPE_F16,GGML_TYPE_F16);
+                check_prefill_requirements(backend.get(),queries,GGML_TYPE_Q8_0,GGML_TYPE_Q4_0);
+                check_attention<8>(queries,queries+1023,3,true,0,1.0f);
+                for (uint32_t flags : {0u,3u}) {
+                    quant_span_fixture encoded(backend.get(),GGML_TYPE_Q8_0,GGML_TYPE_Q4_0,
+                        queries+1023,(queries+1278)/256*256,3,true,flags,false,false);
+                    check_attention<8,GGML_TYPE_Q8_0,GGML_TYPE_Q4_0>(queries,queries+1023,3,true,0,1.0f,&encoded);
+                }
+            }
+            std::puts("Prefill MMA widths 9-1024 preserve stock output and checkpoint bits");
+            return 0;
+        }
+        if (argc == 2 && !std::strcmp(argv[1],"--case-mma-checkpoint")) {
+            check_attention<1>(1,1023,3,false,1,16.0f);
+            std::puts("MMA checkpoint stress case matches stock");
+            return 0;
+        }
+        if (argc == 2 && !std::strcmp(argv[1],"--case-mma-checkpoint-tg2")) {
+            check_attention<2>(2,8192,3,false,1,16.0f);
+            std::puts("MMA TG2 checkpoint stress case matches stock");
+            return 0;
+        }
+#ifdef FATTN_MMA_RESUME_ONLY
+        const auto cases=check_attention_matrix(quick)+
+            check_encoded_attention_pair<GGML_TYPE_Q8_0,GGML_TYPE_Q4_0>(backend.get(),quick,true)+
+            check_encoded_attention_pair<GGML_TYPE_BF16,GGML_TYPE_BF16>(backend.get(),quick,false);
+        std::printf("Native MMA resume: %zu cases passed, zero output/metadata mismatches\n",cases);
+#else
+        const auto conversion_cases = check_decoding<GGML_TYPE_Q8_0>(backend.get(),quick)+
+            check_decoding<GGML_TYPE_Q4_0>(backend.get(),quick)+check_decoding<GGML_TYPE_Q4_1>(backend.get(),quick)+
+            check_decoding<GGML_TYPE_Q5_0>(backend.get(),quick)+check_decoding<GGML_TYPE_Q5_1>(backend.get(),quick)+
+            check_decoding<GGML_TYPE_F16>(backend.get(),quick)+check_decoding<GGML_TYPE_BF16>(backend.get(),quick);
+        std::printf("Encoded conversion: %zu cases passed, zero byte mismatches\n",conversion_cases);
+        const auto staged_cases = check_encoded_tile_type<GGML_TYPE_Q8_0>(backend.get(),quick)+
+            check_encoded_tile_type<GGML_TYPE_Q4_0>(backend.get(),quick)+check_encoded_tile_type<GGML_TYPE_Q4_1>(backend.get(),quick)+
+            check_encoded_tile_type<GGML_TYPE_Q5_0>(backend.get(),quick)+check_encoded_tile_type<GGML_TYPE_Q5_1>(backend.get(),quick)+
+            check_encoded_tile_type<GGML_TYPE_BF16>(backend.get(),quick)+check_encoded_tile_type<GGML_TYPE_F16>(backend.get(),quick);
+        std::printf("Encoded staging: %zu cases passed, zero byte mismatches\n",staged_cases);
+        const auto quant_attention = check_encoded_attention_values<GGML_TYPE_Q8_0>(backend.get(),quick)+
+            check_encoded_attention_values<GGML_TYPE_Q4_0>(backend.get(),quick)+check_encoded_attention_values<GGML_TYPE_Q4_1>(backend.get(),quick)+
+            check_encoded_attention_values<GGML_TYPE_Q5_0>(backend.get(),quick)+check_encoded_attention_values<GGML_TYPE_Q5_1>(backend.get(),quick)+
+            check_encoded_attention_values<GGML_TYPE_BF16>(backend.get(),quick)+check_encoded_attention_values<GGML_TYPE_F16>(backend.get(),quick);
+        std::printf("Encoded MMA: %zu cases passed, zero output/metadata mismatches\n",quant_attention);
+        size_t cases = check_loads<128,32,false>(quick)+check_loads<132,64,false>(quick);
+        cudaDeviceProp properties{};
+        check_cuda(cudaGetDeviceProperties(&properties,0));
+        if (properties.major >= 8) cases += check_loads<128,32,true>(quick)+check_loads<132,64,true>(quick);
+        std::printf("FP16 span tile probes: %zu cases passed, zero byte mismatches\n",cases);
+        const auto attention_cases = check_attention_matrix(quick);
+        std::printf("FP16 span MMA: %zu cases passed, zero output/metadata mismatches\n",attention_cases);
+#endif
+    } catch (const std::exception & error) {
+        std::fprintf(stderr,"FP16 span test failed: %s\n",error.what());
+        return 1;
+    }
+}
diff --git a/tests/test-cuda-graph-types.cpp b/tests/test-cuda-graph-types.cpp
new file mode 100644
index 00000000..41a9a9cd
--- /dev/null
+++ b/tests/test-cuda-graph-types.cpp
@@ -0,0 +1,38 @@
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "ggml.h"
+
+#include <cstdio>
+#include <vector>
+
+// Keep source pointers, dimensions and strides unchanged while reusing a captured conversion graph.
+int main() {
+    ggml_backend_load_all();
+    ggml_backend_ptr backend(ggml_backend_init_by_name("CUDA0",nullptr));
+    if (!backend) return 77;
+    ggml_context_ptr context(ggml_init({1024*1024,nullptr,true}));
+    auto * source = ggml_new_tensor_2d(context.get(),GGML_TYPE_F16,256,4);
+    auto * output = ggml_cast(context.get(),source,GGML_TYPE_F32);
+    auto * graph = ggml_new_graph(context.get());
+    ggml_build_forward_expand(graph,output);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(context.get(),backend.get()));
+    if (!buffer) return 1;
+    std::vector<uint16_t> encoded(1024,0x3c00);
+    ggml_backend_tensor_set(source,encoded.data(),0,encoded.size()*sizeof(uint16_t));
+    std::vector<float> actual(1024);
+    for (auto type : {GGML_TYPE_F16,GGML_TYPE_BF16,GGML_TYPE_F16,GGML_TYPE_BF16}) {
+        source->type = type;
+        const float expected = type == GGML_TYPE_F16 ? 1.0f : 0.0078125f;
+        for (int repeat = 0; repeat < 5; ++repeat) {
+            if (ggml_backend_graph_compute(backend.get(),graph) != GGML_STATUS_SUCCESS) return 1;
+            ggml_backend_synchronize(backend.get());
+            ggml_backend_tensor_get(output,actual.data(),0,actual.size()*sizeof(float));
+            for (float value : actual) if (value != expected) {
+                std::fprintf(stderr,"graph source type %s: expected %g, got %g\n",ggml_type_name(type),expected,value);
+                return 1;
+            }
+        }
+    }
+    std::puts("Type-changing graph capture reuse passed");
+    return 0;
+}
diff --git a/tests/test-cuda-kv-host.cpp b/tests/test-cuda-kv-host.cpp
new file mode 100644
index 00000000..a01b9ed6
--- /dev/null
+++ b/tests/test-cuda-kv-host.cpp
@@ -0,0 +1,97 @@
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "testing.h"
+
+#include <cuda_runtime_api.h>
+#include <cstdlib>
+#include <cstring>
+
+using host_type_fn = ggml_backend_buffer_type_t (*)(int);
+using host_register_fn = ggml_backend_buffer_t (*)(int, ggml_backend_buffer_t);
+
+// A mapped allocation must support actual device writes, not just host memcpy.
+static void mapped_write(testing & t, ggml_backend_buffer_t buffer, uint8_t value) {
+    void * host = ggml_backend_buffer_get_base(buffer);
+    void * mapped = nullptr;
+    if (!t.assert_true(cudaHostGetDevicePointer(&mapped, host, 0) == cudaSuccess)) return;
+    t.assert_true(cudaMemset(mapped, value, ggml_backend_buffer_get_size(buffer)) == cudaSuccess);
+    t.assert_true(cudaDeviceSynchronize() == cudaSuccess);
+    auto * bytes = static_cast<uint8_t *>(host);
+    t.assert_true(std::all_of(bytes, bytes + ggml_backend_buffer_get_size(buffer), [value](uint8_t x) { return x == value; }));
+}
+
+int main() {
+    ggml_backend_load_all();
+    auto * reg = ggml_backend_reg_by_name("CUDA");
+    if (!reg || !ggml_backend_reg_dev_count(reg)) return 77;
+    testing t;
+    auto type_fn = reinterpret_cast<host_type_fn>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_host_buffer_type"));
+    auto register_fn = reinterpret_cast<host_register_fn>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_host_buffer_register"));
+    t.test("strict_host_hooks_exist", [&](testing & t) { t.assert_true(type_fn && register_fn); });
+    if (!type_fn || !register_fn) return t.summary();
+    auto * type = type_fn(0);
+    if (!t.assert_true(type != nullptr)) return t.summary();
+    if (std::getenv("GGML_CUDA_NO_PINNED")) {
+        t.test("disabled_pinning_does_not_fall_back", [&](testing & t) {
+            ggml_backend_buffer_ptr owner(ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), 8192));
+            ggml_backend_buffer_ptr allocated(ggml_backend_buft_alloc_buffer(type, 4096));
+            ggml_backend_buffer_ptr registered(register_fn(0, owner.get()));
+            t.assert_true(!allocated && !registered);
+        });
+        return t.summary();
+    }
+    t.test("invalid_devices_and_owners", [&](testing & t) {
+        t.assert_true(type_fn(-1) == nullptr);
+        t.assert_true(type_fn(int(ggml_backend_reg_dev_count(reg))) == nullptr);
+        t.assert_true(register_fn(0, nullptr) == nullptr);
+    });
+    t.test("allocated_mapping_flags_and_last_view_lifetime", [&](testing & t) {
+        ggml_backend_buffer_ptr root(ggml_backend_buft_alloc_buffer(type, 8192));
+        if (!t.assert_true(root != nullptr)) return;
+        t.assert_true(ggml_backend_buffer_get_type(root.get()) == type);
+        t.assert_true(ggml_backend_buffer_is_host(root.get()));
+        unsigned int flags = 0;
+        t.assert_true(cudaHostGetFlags(&flags, ggml_backend_buffer_get_base(root.get())) == cudaSuccess);
+        t.assert_true((flags & cudaHostAllocMapped) != 0);
+#ifdef _WIN32
+        t.assert_true((flags & cudaHostAllocWriteCombined) == 0);
+#else
+        t.assert_true((flags & cudaHostAllocWriteCombined) != 0);
+#endif
+        mapped_write(t, root.get(), 0x31);
+        ggml_backend_buffer_ptr duplicate(register_fn(0, root.get()));
+        t.assert_true(duplicate == nullptr);
+        mapped_write(t, root.get(), 0x32);
+        ggml_backend_buffer_ptr view(ggml_backend_buffer_view(root.get(), 128, 4096));
+        if (!t.assert_true(view != nullptr)) return;
+        root.reset();
+        ggml_backend_buffer_clear(view.get(), 0x52);
+        t.assert_equal(uint8_t(0x52), *static_cast<uint8_t *>(ggml_backend_buffer_get_base(view.get())));
+    });
+    t.test("registered_storage_retains_owner_and_unregisters_once", [&](testing & t) {
+        ggml_backend_buffer_ptr owner(ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), 16384));
+        auto base = reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(owner.get()));
+        size_t offset = (4096 - base % 4096) % 4096;
+        ggml_backend_buffer_ptr page(ggml_backend_buffer_view(owner.get(), offset, 8192));
+        ggml_backend_buffer_ptr registered(register_fn(0, page.get()));
+        if (!t.assert_true(registered != nullptr)) return;
+        mapped_write(t, registered.get(), 0x19);
+        // An existing registration must not be adopted or undone by a failed second registration.
+        ggml_backend_buffer_ptr duplicate(register_fn(0, page.get()));
+        t.assert_true(duplicate == nullptr);
+        mapped_write(t, registered.get(), 0x21);
+        registered.reset();
+        ggml_backend_buffer_ptr again(register_fn(0, page.get()));
+        if (!t.assert_true(again != nullptr)) return;
+        owner.reset(); page.reset();
+        mapped_write(t, again.get(), 0x29);
+    });
+    t.test("allocation_failure_is_recoverable", [&](testing & t) {
+        ggml_backend_buffer_ptr failed(ggml_backend_buft_alloc_buffer(type, SIZE_MAX));
+        t.assert_true(failed == nullptr);
+        t.assert_true(cudaGetLastError() == cudaSuccess);
+        ggml_backend_buffer_ptr valid(ggml_backend_buft_alloc_buffer(type, 4096));
+        if (t.assert_true(valid != nullptr)) mapped_write(t, valid.get(), 0x42);
+    });
+    return t.summary();
+}
diff --git a/tests/test-cuda-kv-runtime-config.cmake b/tests/test-cuda-kv-runtime-config.cmake
