+    GGML_ASSERT(supported_context.alloc_count == 1 && supported_context.physical_free_count == 0);
+    GGML_ASSERT(unsupported_context.alloc_count == 1 && unsupported_context.physical_free_count == 1);
+
+    ggml_init_params params = {
