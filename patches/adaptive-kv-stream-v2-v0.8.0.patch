+    buffer->iface.get_base = [](ggml_backend_buffer_t) -> void * { return (void *) (UINTPTR_MAX - 7); };
+    GGML_ASSERT(!ggml_tallocr_new_range(&alloc, buffer.get(), 8, 8));
