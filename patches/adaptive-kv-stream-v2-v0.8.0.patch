+    });
+    if (cuda) t.test("producer_tail_crosses_resident_boundary_without_losing_previous_rows", [&](testing & t) {
+        fixture f(backend.get(),true,GGML_TYPE_Q5_1,GGML_TYPE_Q4_1,513);
