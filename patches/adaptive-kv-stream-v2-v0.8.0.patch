+            ggml_backend_buffer_clear(buffer, 0);
+            auto copy = [&](const llama_kv_stream_copy_span & span) {
+                const auto & layout = host->layout();
+                const size_t stride = span.rows.operand == operand::k ? layout.k_token_bytes : layout.v_token_bytes;
