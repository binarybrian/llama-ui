+    // Retire pending DMA before releasing the logical session, including failure/cancellation.
+    void stop_sequence(bool success = false) {
+        if (!sequence) return;
+        finished_sequence = sequence->stats;
+        if (sequence->started) {
+            copy_ops->drain(copies.get());
