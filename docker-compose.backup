# TrueNAS Custom App — llama.cpp server + embedded Web UI
#
# Install via: TrueNAS SCALE (Electric Eel) → Apps → Custom Apps →
#             "Install via YAML" → paste this content.
#
# Host: 192.168.2.1   Port: 30084 (WebUI + OpenAI-compatible API)
#
# Image is published to Docker Hub (anonymous pull). The model files are
# bind-mounted read-only from the vega pool — keep them on SSD for fast load.
services:
  llama-ui:
    image: docker.io/binarybrian/llama-ui:4060ti-mtp-iq2m
    container_name: llama-ui
    pull_policy: always
    ports:
      - "30084:8080"
    volumes:
      # /mnt/vega/models on TrueNAS -> /models inside the container (read-only)
      - /mnt/vega/models:/models:ro
    environment:
      # Qwen3.6-27B IQ2_M (fits 16GB VRAM with auto-fit context)
      - MODEL_PATH=/models/qwen36-dau/Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MAX-NEO-MTP-IQ2_M.gguf
      - MMPROJ_PATH=/models/qwen36-dau/mmproj-BF16.gguf
      - ALIAS=qwable-dau
      - TRY_MTP=1
      - CTX_SIZE=auto
      - CTK=q5_0
      - CTV=q4_0
      - CTKD=q4_0
      - CTVD=q4+0
      - AGENT=1
      - CORS_ORIGINS=*
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    restart: unless-stopped
